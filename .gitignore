# Legacy local development outputs (not part of the public layout)
/artifacts/**
/workspace/**

# Local compiler backups and investigation outputs
/local_backups/
/local_results/

# Compiler-owned inputs and outputs
/compiler/models/*
!/compiler/models/.gitignore
/compiler/datasets/calibration/*
!/compiler/datasets/calibration/.gitignore
/compiler/datasets/upstream/*
!/compiler/datasets/upstream/.gitignore
/compiler/outputs/*
!/compiler/outputs/.gitignore

# Inference-owned model files and outputs
/inference/models/*
!/inference/models/.gitignore
/inference/outputs/*
!/inference/outputs/.gitignore

# Colcon workspace outputs live at the repository root, outside the ROS package.
/build/
/install/
/log/

