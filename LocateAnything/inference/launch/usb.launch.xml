<launch>
  <arg name="device" default="/dev/video0"/>
  <arg name="width" default="1920"/>
  <arg name="height" default="1080"/>
  <arg name="fps" default="30"/>
  <arg name="prompt" default="/detect person"/>
  <arg name="model_directory" default=""/>
  <arg name="output_directory" default="inference/outputs"/>

  <include file="$(find-pkg-share locateanything)/launch/locateanything.launch.xml">
    <arg name="use_shared_memory" value="true"/>
    <arg name="model_directory" value="$(var model_directory)"/>
    <arg name="output_directory" value="$(var output_directory)"/>
    <arg name="prompt" value="$(var prompt)"/>
  </include>
  <include file="$(find-pkg-share hobot_usb_cam)/launch/hobot_usb_cam.launch.py">
    <arg name="usb_video_device" value="$(var device)"/>
    <arg name="usb_image_width" value="$(var width)"/>
    <arg name="usb_image_height" value="$(var height)"/>
    <arg name="usb_framerate" value="$(var fps)"/>
    <arg name="usb_zero_copy" value="True"/>
  </include>
</launch>
