<launch>
  <arg name="config" default="config.yaml"/>
  <arg name="input" default="/hbmem_img"/>
  <arg name="prompt" default="/detect person"/>
  <include file="$(find-pkg-share hobot_shm)/launch/hobot_shm.launch.py"/>
  <node pkg="locateanything" exec="inference" name="locateanything" output="screen">
    <param from="$(var config)"/>
    <param name="input_topic" value="$(var input)" type="str"/>
    <param name="default_prompt" value="$(var prompt)" type="str"/>
  </node>
</launch>
