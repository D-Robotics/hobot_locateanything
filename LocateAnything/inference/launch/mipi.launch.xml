<launch>
  <arg name="width" default="1920"/>
  <arg name="height" default="1080"/>
  <arg name="fps" default="30.0"/>
  <arg name="channel" default="0"/>
  <arg name="prompt" default="/detect person"/>
  <arg name="model_directory" default=""/>
  <arg name="output_directory" default="inference/outputs"/>

  <include file="$(find-pkg-share locateanything)/launch/locateanything.launch.xml">
    <arg name="use_shared_memory" value="true"/>
    <arg name="model_directory" value="$(var model_directory)"/>
    <arg name="output_directory" value="$(var output_directory)"/>
    <arg name="prompt" value="$(var prompt)"/>
  </include>
  <include file="$(find-pkg-share mipi_cam)/launch/mipi_cam.launch.py">
    <arg name="mipi_image_width" value="$(var width)"/>
    <arg name="mipi_image_height" value="$(var height)"/>
    <arg name="mipi_image_framerate" value="$(var fps)"/>
    <arg name="mipi_channel" value="$(var channel)"/>
    <arg name="mipi_out_format" value="nv12"/>
    <arg name="mipi_io_method" value="shared_mem"/>
    <arg name="mipi_frame_ts_type" value="realtime"/>
  </include>
</launch>
